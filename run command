# ==========================================================================
#  INTEL CODE — Setup & Run Guide  (WSL / Linux)
# ==========================================================================
#
#  PREREQUISITES:
#    • Go 1.26+    (brew install go  or  apt install golang)
#    • Python 3.12 (with venv —  apt install python3.12-venv)
#    • Node.js 22+  (fnm use 22  or  nvm use 22)
#    • PostgreSQL   (docker run postgres  or  apt install postgresql)
#    • DeepSeek API key → put in backend/.env  (DeepSeek sign‑up, free tier)
#
#  Before you start, create the database:
#    createdb codeclass
#    (or use the default connection string below)
# ==========================================================================

# ---- 1. Backend .env -----------------------------------------------
# Create backend/.env with these 5 lines:
cat > backend/.env << 'EOF'
PORT=8080
DB_URL=postgresql://postgres:password@localhost:5432/codeclass?sslmode=disable
JWT_SECRET=change_me_to_a_random_string
DEEPSEEK_API_KEY=sk-your-key-here
ML_SERVICE_URL=http://localhost:8081
EOF

# ---- 2. ML Service setup -------------------------------------------
cd ml-service

# Delete stale model from another OS (pickle is not cross-platform)
rm -f model.joblib vectorizer.joblib

# Create venv & activate (MUST use python3.12 — 3.14 has no numpy wheel)
python3.12 -m venv venv
source venv/bin/activate

# Install torch CPU-only (MUCH smaller than CUDA — ~180MB vs 2.5GB)
pip install torch --index-url https://download.pytorch.org/whl/cpu

# Install remaining deps (first run downloads CodeBERT model ~500MB)
pip install -r requirements.txt

# Generate training data & train classifier
python seed_data.py
python train_model.py           # prints accuracy report — aim for 70%+

# ---- 3. Run everything (3 terminals) -------------------------------
# Terminal 1 — ML Service (port 8081)
cd ml-service && source venv/bin/activate && python app.py

# Terminal 2 — Backend (port 8080)
cd backend && go run main.go

# Terminal 3 — Frontend (port 5173)
cd frontend && npm install && npm run dev


